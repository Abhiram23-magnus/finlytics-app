{
  "name": "finlytics",
  "version": "1.0.0",
  "description": "Full-stack personal expense tracker",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/migrate.js && node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "seed:demo": "node scripts/seed-demo.js",
    "import:json": "node scripts/import-json.js",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "node test/e2e/browser.e2e.js",
    "vendor:chart": "node -e \"require('fs').copyFileSync('node_modules/chart.js/dist/chart.umd.min.js','public/vendor/chart.umd.min.js')\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "chart.js": "^4.5.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "playwright-core": "^1.56.1",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
