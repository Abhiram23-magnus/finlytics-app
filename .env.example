# ============================================================
# Finlytics environment variables — copy to .env and fill in.
# Never commit real values. All values below are placeholders.
# ============================================================

# development | test | production
NODE_ENV=development
PORT=3000

# ── PostgreSQL (required) ──
# Use your provider's *pooled* connection string on serverless platforms.
DATABASE_URL=postgres://finlytics:change-me@localhost:5432/finlytics
# require (default in production, verifies certificates) | no-verify | disable (default in development)
DATABASE_SSL=disable
# Max connections per app instance (default 10; 3 on Vercel)
# DB_POOL_MAX=10

# ── Sessions (required in production, ≥ 32 random chars) ──
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Public base URL of the app, used to build password-reset links (https in production)
APP_BASE_URL=http://localhost:3000

# Reverse-proxy trust for correct client IPs / HTTPS detection.
# Default: 1 on Vercel, off elsewhere. Examples: 1, loopback, 10.0.0.0/8
# TRUST_PROXY=1

# Extra origins allowed to call the API with credentials (comma-separated).
# Leave empty when the frontend is served by this app (same origin).
CORS_ORIGINS=

# Show the "use demo account" shortcut on the login page (default: on in dev, off in production)
# DEMO_MODE=false

# ── Email for password recovery (optional) ──
# When SMTP_HOST is empty, password recovery is disabled and the UI says so.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); otherwise STARTTLS is required
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Finlytics <no-reply@example.com>"
# RESET_TOKEN_TTL_MINUTES=30

# ── Rate limits (requests per 15 minutes per IP; API is per minute) ──
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_REGISTER=5
# RATE_LIMIT_PASSWORD_RESET=5
# RATE_LIMIT_API=600
